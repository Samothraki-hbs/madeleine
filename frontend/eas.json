{
  "cli": {
    "version": ">= 16.14.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      
      "developmentClient": true,
      "distribution": "internal",
      "node": {
        "installation" : {
          "command": "npm install --legacy-peer-deps"
        }
      }
      
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
